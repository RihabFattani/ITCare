# Copier ce fichier en ".env" (jamais commite) et remplir les valeurs.
# Mot de passe MySQL (non vide)
DB_PASSWORD=changez-moi-mot-de-passe-mysql
# Secret JWT : 32 caracteres minimum (ex. generer avec : openssl rand -hex 32)
JWT_SECRET=changez-moi-secret-jwt-de-32-caracteres-minimum
# URL publique du site, sans "/" final (liens d'activation et de reinitialisation)
PUBLIC_URL=http://localhost

# SMTP (pour les e-mails d activation et de mot de passe oublie). Gmail : mot de passe d application, sans espaces.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Port public du site (80 par defaut ; changer si deja utilise, ex. 8088)
HTTP_PORT=80
